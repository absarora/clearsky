<%# app/views/forecasts/_forecast.html.erb
  #
  # Forecast results partial. Rendered inside the Turbo Frame on
  # both cache hits and live API responses.
  #
  # Handles NullForecast gracefully — displays an error state when
  # presenter.current_temperature returns "--°F".
%>

<div class="w-full max-w-md mx-auto">

  <%# ── Cache indicator ───────────────────────────────────────────────── %>
  <% if presenter.cached_indicator %>
    <div class="flex justify-end mb-2">
      <span class="text-xs font-medium px-2 py-1 bg-amber-100 text-amber-700 rounded-full border border-amber-200">
        ⚡ <%= presenter.cached_indicator %>
      </span>
    </div>
  <% end %>

  <%# ── NullForecast error state ──────────────────────────────────────── %>
  <% if presenter.current_temperature == "--°F" %>
    <div class="bg-white rounded-2xl shadow-md p-6 text-center">
      <p class="text-gray-500 text-sm">Unable to retrieve forecast. Please check the zip code and try again.</p>
    </div>

  <%# ── Current conditions card ───────────────────────────────────────── %>
  <% else %>
    <div class="bg-white rounded-2xl shadow-md p-6 mb-4">

      <div class="flex items-start justify-between mb-4">
        <div>
          <p class="text-gray-500 text-sm"><%= presenter.location_name %></p>
          <p class="text-5xl font-bold text-gray-900 mt-1"><%= presenter.current_temperature %></p>
          <p class="text-gray-600 mt-1"><%= presenter.condition %></p>
        </div>
        <div class="text-right text-sm text-gray-500 space-y-1">
          <p>H: <%= presenter.high_temperature %></p>
          <p>L: <%= presenter.low_temperature %></p>
        </div>
      </div>

      <%# ── Current conditions detail grid ─────────────────────────────── %>
      <div class="grid grid-cols-3 gap-3 pt-4 border-t border-gray-100">
        <div class="text-center">
          <p class="text-xs text-gray-400 uppercase tracking-wide">Feels Like</p>
          <p class="text-sm font-medium text-gray-700 mt-1"><%= presenter.feels_like %></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-gray-400 uppercase tracking-wide">Humidity</p>
          <p class="text-sm font-medium text-gray-700 mt-1"><%= presenter.humidity %>%</p>
        </div>
        <div class="text-center">
          <p class="text-xs text-gray-400 uppercase tracking-wide">Wind</p>
          <p class="text-sm font-medium text-gray-700 mt-1"><%= presenter.wind_mph %> mph</p>
        </div>
      </div>
    </div>

    <%# ── Extended forecast ──────────────────────────────────────────────── %>
    <% if presenter.forecast_days.any? %>
      <div class="bg-white rounded-2xl shadow-md p-4">
        <p class="text-xs text-gray-400 uppercase tracking-wide mb-3">7-Day Forecast</p>
        <div class="space-y-3">
          <% presenter.forecast_days.each do |day| %>
            <div class="flex items-center justify-between text-sm">
              <span class="w-24 text-gray-600"><%= presenter.format_day_date(day) %></span>
              <span class="flex-1 text-center text-gray-500 text-xs"><%= day.condition %></span>
              <span class="text-gray-700 font-medium"><%= presenter.format_day_temperature(day) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  <% end %>
</div>
